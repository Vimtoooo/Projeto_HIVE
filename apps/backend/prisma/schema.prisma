datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}
// ==========================================
// ENUMERADORES (ENUMS)
// ==========================================

enum FormaPagamento {
  CARTAO
  PIX
  BOLETO
  DINHEIRO
  TRANSFERENCIA
}

enum MeioIndicado {
  APLICATIVO
  WHATSAPP
  EMAIL
  TELEFONE
  REDES_SOCIAIS
  OUTRO
}

enum StatusConta {
  ATIVO
  INATIVO
  BLOQUEADO
  PENDENTE
}

enum StatusContratacao {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

enum StatusIndicado {
  PENDENTE
  ACEITA
  RECUSADA
  EXPIRADA
}

enum StatusPagamento {
  PENDENTE
  PAGO
  PARCIALMENTE_PAGO
  CANCELADO
  ESTORNADO
}

enum StatusServico {
  ATIVO
  INATIVO
}

enum TipoRegistro {
  RECEITA
  DESPESA
}

enum TipoUsuario {
  CONTRATANTE
  PRESTADOR
  AMBOS
}

// ==========================================
// MODELOS / ENTIDADES
// ==========================================

model Usuario {
  favoritos Favorito[]
  notificacoes Notificacao[]
  idUsuario        Int          @id @default(autoincrement())
  nome             String
  email            String       @unique
  senha            String
  telefone         String
  cpf              String       @unique
  endereco         String
  tipoUsuario      TipoUsuario
  dataCadastro     DateTime     @default(now())
  statusConta      StatusConta  @default(PENDENTE)

  // Extensão de herança para Prestador
  sessoes Sessao[]
  conversasCliente Conversa[] @relation("ClienteConversa")
  conversasPrestador Conversa[] @relation("PrestadorConversa")
  mensagens Mensagem[]
  prestadorPerfil Prestador?

  // Relacionamentos
  contratacoes     Contratacao[] @relation("UsuarioContratacoes")
  indicacoesFeitas Indicacao[]   @relation("Indicador")
  faturas          Fatura[]
}

model Prestador {
  favoritadoPor Favorito[]
  idPrestador     Int      @id
  areaAtuacao     String
  experiencia     String
  certificacoes   String[]
  avaliacaoMedia  Float    @default(0.0)
  cnpj            String   @unique

  // Vínculo 1:1 simulando a Herança de Usuario
  usuario         Usuario  @relation(fields: [idPrestador], references: [idUsuario], onDelete: Cascade)

  // Relacionamentos
  servicos            Servico[]
  indicacoesRecebidas Indicacao[] @relation("Indicado")
}

model Servico {
  idServico    Int           @id @default(autoincrement())
  titulo       String
  descricao    String        @db.Text
  precoBase    Float
  dataCadastro DateTime      @default(now())
  status       StatusServico @default(ATIVO)

  // Relacionamentos
  prestadorId  Int
  prestador    Prestador     @relation(fields: [prestadorId], references: [idPrestador], onDelete: Cascade)
  contratacoes Contratacao[]
}

model Contratacao {
  notificacoes Notificacao[]
  chave String? @db.Uuid
  @@unique([contratanteId, chave])
  idContratacao   Int               @id @default(autoincrement())
  dataContratacao DateTime          @default(now())
  status          StatusContratacao @default(PENDENTE)
  valor           Float
  formaPagamento  FormaPagamento
  dataVencimento  DateTime?

  // Relacionamentos
  indicacaoId    Int?
  indicacao      Indicacao?        @relation(fields: [indicacaoId], references: [idIndicacao])

  servicoId      Int
  servico        Servico           @relation(fields: [servicoId], references: [idServico])

  contratanteId  Int
  contratante    Usuario           @relation("UsuarioContratacoes", fields: [contratanteId], references: [idUsuario])

  fatura         Fatura?
  avaliacao      Avaliacao?
  financeiros    Financeiro[]
}

model Indicacao {
  idIndicacao     Int            @id @default(autoincrement())
  meioIndicado    MeioIndicado   @map("meioIndicacao")
  dataIndicado    DateTime       @default(now()) @map("dataIndicacao")
  statusIndicacao StatusIndicado @default(PENDENTE)
  observacao      String         @db.Text

  // Relacionamentos
  indicadorId     Int
  indicador       Usuario        @relation("Indicador", fields: [indicadorId], references: [idUsuario])

  indicadoId      Int
  indicado        Prestador      @relation("Indicado", fields: [indicadoId], references: [idPrestador])

  contratacoes    Contratacao[]
}

model Avaliacao {
  idAvaliacao    Int         @id @default(autoincrement())
  nota           Float
  comentario     String?     @db.Text
  dataAvaliacao  DateTime    @default(now())

  // Relacionamentos
  contratacaoId  Int         @unique
  contratacao    Contratacao @relation(fields: [contratacaoId], references: [idContratacao], onDelete: Cascade)
}

model Fatura {
  idFatura        Int             @id @default(autoincrement())
  dataEmissao     DateTime        @default(now())
  valorTotal      Float
  statusPagamento StatusPagamento @default(PENDENTE)
  dataPagamento   DateTime?

  // Relacionamentos
  usuarioId       Int
  usuario         Usuario         @relation(fields: [usuarioId], references: [idUsuario])

  contratacaoId   Int             @unique
  contratacao     Contratacao     @relation(fields: [contratacaoId], references: [idContratacao], onDelete: Cascade)

  financeiros     Financeiro[]
}

model Financeiro {
  idFinanceiro  Int          @id @default(autoincrement())
  tipoRegistro  TipoRegistro
  valor         Float
  descricao     String?      @db.Text
  dataRegistro  DateTime     @default(now())

  // Relacionamentos
  faturaId      Int?
  fatura        Fatura?      @relation(fields: [faturaId], references: [idFatura])

  contratacaoId Int
  contratacao   Contratacao  @relation(fields: [contratacaoId], references: [idContratacao])
}
model Sessao {
  tokenHash String @id
  usuarioId Int
  expiraEm DateTime
  usuario Usuario @relation(fields: [usuarioId], references: [idUsuario], onDelete: Cascade)
  @@index([usuarioId])
  @@index([expiraEm])
}
model Conversa {
  id Int @id @default(autoincrement())
  clienteId Int
  prestadorId Int
  atualizadaEm DateTime @default(now())
  cliente Usuario @relation("ClienteConversa", fields: [clienteId], references: [idUsuario], onDelete: Cascade)
  prestador Usuario @relation("PrestadorConversa", fields: [prestadorId], references: [idUsuario], onDelete: Cascade)
  mensagens Mensagem[]
  @@unique([clienteId, prestadorId])
  @@index([prestadorId, atualizadaEm])
  @@index([clienteId, atualizadaEm])
}
model Mensagem {
  notificacoes Notificacao[]
  id Int @id @default(autoincrement())
  conversaId Int
  remetenteId Int
  conteudo String @db.VarChar(2000)
  enviadaEm DateTime @default(now())
  chave String @db.Uuid
  conversa Conversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  remetente Usuario @relation(fields: [remetenteId], references: [idUsuario], onDelete: Cascade)
  @@unique([conversaId, remetenteId, chave])
  @@index([conversaId, id])
}

enum TipoNotificacao {
  NOVA_MENSAGEM
  SOLICITACAO_CRIADA
  SOLICITACAO_ACEITA
  SOLICITACAO_RECUSADA
  SOLICITACAO_CONCLUIDA
  SOLICITACAO_CANCELADA
}

model Notificacao {
  id            Int             @id @default(autoincrement())
  usuarioId     Int
  usuario       Usuario         @relation(fields: [usuarioId], references: [idUsuario], onDelete: Cascade)
  tipo          TipoNotificacao
  chaveEvento   String          @db.VarChar(100)
  titulo        String          @db.VarChar(100)
  descricao     String          @db.VarChar(500)
  criadaEm      DateTime        @default(now())
  lidaEm        DateTime?
  contratacaoId Int?
  contratacao   Contratacao?    @relation(fields: [contratacaoId], references: [idContratacao], onDelete: Cascade)
  mensagemId    Int?
  mensagem      Mensagem?       @relation(fields: [mensagemId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, chaveEvento])
  @@index([usuarioId, id])
  @@index([usuarioId, lidaEm, id])
}

model Favorito {
  usuarioId Int
  prestadorId Int
  criadoEm DateTime @default(now())
  usuario Usuario @relation(fields: [usuarioId], references: [idUsuario], onDelete: Cascade)
  prestador Prestador @relation(fields: [prestadorId], references: [idPrestador], onDelete: Cascade)
  @@id([usuarioId, prestadorId])
  @@index([prestadorId])
}
