### 21. Preço mínimo igual a zero
# Esperado: HTTP 200
# expectedStatus: 200
# expectedCount: 10
GET {{baseUrl}}/servicos?texto={{executionId}}&precoMin=0
Accept: application/json

### 22. Preço máximo igual a zero: vazio
# Esperado: HTTP 200
# expectedStatus: 200
# expectedCount: 0
GET {{baseUrl}}/servicos?texto={{executionId}}&precoMax=0
Accept: application/json

### 23. Limite inclusivo de um centavo
# Esperado: HTTP 200
# expectedStatus: 200
# expectedCount: 1
GET {{baseUrl}}/servicos?texto={{executionId}}&precoMin=0.01&precoMax=0.01
Accept: application/json

### 24. Limite inclusivo de um milhão
# Esperado: HTTP 200
# expectedStatus: 200
# expectedCount: 1
GET {{baseUrl}}/servicos?texto={{executionId}}&precoMin=1000000&precoMax=1000000
Accept: application/json

### 25. Faixa de R$ 100 a R$ 300
# Esperado: HTTP 200
# expectedStatus: 200
# expectedCount: 4
GET {{baseUrl}}/servicos?texto={{executionId}}&precoMin=100&precoMax=300
Accept: application/json

### 26. Preço exato com centavos
# Esperado: HTTP 200
# expectedStatus: 200
# expectedCount: 1
GET {{baseUrl}}/servicos?texto={{executionId}}&precoMin=199.99&precoMax=199.99
Accept: application/json

### 27. Área e preço sem combinação
# Esperado: HTTP 200
# expectedStatus: 200
# expectedCount: 0
GET {{baseUrl}}/servicos?texto={{executionId}}&areaAtuacao=Montagem&precoMax=100
Accept: application/json

### 28. Texto com espaços externos normalizados
# Esperado: HTTP 200
# expectedStatus: 200
# expectedCount: 10
GET {{baseUrl}}/servicos?texto=%20{{executionId}}%20
Accept: application/json

### 29. Área com espaços externos normalizados
# Esperado: HTTP 200
# expectedStatus: 200
# expectedCount: 1
GET {{baseUrl}}/servicos?texto={{executionId}}&areaAtuacao=%20Montagem%20
Accept: application/json

### 30. Área, texto, preço e paginação juntos
# Esperado: HTTP 200
# expectedStatus: 200
# expectedCount: 1
GET {{baseUrl}}/servicos?texto={{executionId}}&areaAtuacao=Montagem&precoMin=200&precoMax=200&pagina=1&limite=5
Accept: application/json
