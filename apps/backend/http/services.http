@baseUrl = http://localhost:3000
@executionId = 35b612d3-d246-4ec7-9eb2-24fb697dc0dd

# Use npm run start:demo. Envie um bloco por vez pelo Send Request.
# Para as contagens indicadas, execute primeiro providers.http (lote completo).
# expectedCount é o total de resultados, não o tamanho da página itens.

### 01. Verificar aplicação (não verifica conexão com o banco)
# Esperado: HTTP 200
# expectedStatus: 200
GET {{baseUrl}}/
Accept: application/json

### 02. Listagem com paginação padrão
# Esperado: HTTP 200
# expectedStatus: 200
GET {{baseUrl}}/servicos
Accept: application/json

### 03. Todos os dez serviços do lote
# Esperado: HTTP 200
# expectedStatus: 200
# expectedCount: 10
GET {{baseUrl}}/servicos?texto={{executionId}}
Accept: application/json

### 04. Primeira página com um item
# Esperado: HTTP 200
# expectedStatus: 200
# expectedCount: 10
GET {{baseUrl}}/servicos?texto={{executionId}}&pagina=1&limite=1
Accept: application/json

### 05. Segunda página com um item
# Esperado: HTTP 200
# expectedStatus: 200
# expectedCount: 10
GET {{baseUrl}}/servicos?texto={{executionId}}&pagina=2&limite=1
Accept: application/json

### 06. Último serviço, página 10
# Esperado: HTTP 200
# expectedStatus: 200
# expectedCount: 10
GET {{baseUrl}}/servicos?texto={{executionId}}&pagina=10&limite=1
Accept: application/json

### 07. Página depois do último serviço: itens vazio
# Esperado: HTTP 200
# expectedStatus: 200
# expectedCount: 10
GET {{baseUrl}}/servicos?texto={{executionId}}&pagina=11&limite=1
Accept: application/json

### 08. Maior página permitida: itens vazio
# Esperado: HTTP 200
# expectedStatus: 200
# expectedCount: 10
GET {{baseUrl}}/servicos?texto={{executionId}}&pagina=100000&limite=1
Accept: application/json

### 09. Limite máximo de 100
# Esperado: HTTP 200
# expectedStatus: 200
# expectedCount: 10
GET {{baseUrl}}/servicos?texto={{executionId}}&limite=100
Accept: application/json

### 10. Busca por texto inexistente
# Esperado: HTTP 200
# expectedStatus: 200
# expectedCount: 0
GET {{baseUrl}}/servicos?texto=SEM_RESULTADO_{{executionId}}
Accept: application/json

### 11. Filtrar área Montagem
# Esperado: HTTP 200
# expectedStatus: 200
# expectedCount: 1
GET {{baseUrl}}/servicos?texto={{executionId}}&areaAtuacao=Montagem
Accept: application/json

### 12. Filtrar área Eletrica
# Esperado: HTTP 200
# expectedStatus: 200
# expectedCount: 1
GET {{baseUrl}}/servicos?texto={{executionId}}&areaAtuacao=Eletrica
