@baseUrl = http://localhost:3333
@executionId = 35b612d3-d246-4ec7-9eb2-24fb697dc0dd

# Use npm run start:demo. Envie um bloco por vez pelo Send Request.
# Execute de 01 a 30, em ordem, começando com o lote limpo.
# Cada grupo cadastra, consulta e verifica duplicidade; ficam 10 prestadores.

### 01. Cadastro padrão — criar
# Esperado: HTTP 201
# expectedStatus: 201
POST {{baseUrl}}/prestadores
Accept: application/json
Content-Type: application/json

{
  "nome": "Prestador Fictício HTTP01",
  "email": "api-http01.{{executionId}}@example.invalid",
  "senha": "SenhaFicticia!123",
  "telefone": "11999990000",
  "cpf": "61387991216",
  "endereco": "Rua de Testes HTTP, 1",
  "areaAtuacao": "Montagem",
  "experiencia": "Experiência fictícia para testar a API",
  "certificacoes": [
    "Habilidade fictícia"
  ],
  "cnpj": "16783360084128",
  "servico": {
    "titulo": "HTTP01 serviço {{executionId}}",
    "descricao": "Demonstração de serviços com dados fictícios",
    "precoBase": 200
  }
}

### 02. Consultar somente HTTP01 deste lote
# Esperado: HTTP 200
# expectedStatus: 200
# expectedCount: 1
GET {{baseUrl}}/servicos?texto={{executionId}}&areaAtuacao=Montagem
Accept: application/json

