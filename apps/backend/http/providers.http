@baseUrl = http://localhost:3333
# UUID fixo para repetir o cenário, testar duplicidade e limpar depois.
@executionId = 584d56b5-7ca2-49b5-a296-98f91e0b398d

### 1. Cadastrar prestador e serviço inicial (201 na primeira execução)
# Execute com a API iniciada por npm run start:demo.
# Reenviar o mesmo cadastro retorna 409, pois email/CPF/CNPJ são únicos.
# @name createProvider
POST {{baseUrl}}/prestadores
Content-Type: application/json
Accept: application/json

{
  "nome": "Prestador Fictício HTTP",
  "email": "api.{{executionId}}@example.invalid",
  "senha": "SenhaFicticia!123",
  "telefone": "11999990000",
  "cpf": "58456249398",
  "endereco": "Rua de Testes HTTP, 100",
  "areaAtuacao": "Montagem",
  "experiencia": "Montagem de móveis para demonstração",
  "certificacoes": ["Montagem de móveis"],
  "cnpj": "58456249398123",
  "servico": {
    "titulo": "Montagem de mesa HTTP {{executionId}}",
    "descricao": "Serviço fictício para testar a API com REST Client",
    "precoBase": 200
  }
}

### 2. Buscar o cadastro desta demonstração (200; um item após o cadastro)
GET {{baseUrl}}/servicos?texto={{executionId}}
Accept: application/json

### 3. Buscar pelo ID retornado (execute após o POST retornar 201)
# REST Client lê o ID da resposta da requisição nomeada createProvider.
# Se você reenviou o POST e recebeu 409, use a busca por UUID acima.
GET {{baseUrl}}/servicos?prestadorId={{createProvider.response.body.$.prestador.idPrestador}}
Accept: application/json

# Limpeza no terminal do backend (com o mesmo banco de testes):
# npm run test:persistencia:limpar -- 584d56b5-7ca2-49b5-a296-98f91e0b398d
